# Copy to .env and fill in. Never commit .env with real keys.

# eBird, free: https://ebird.org/api/keygen (sign in, it generates instantly)
EBIRD_API_KEY=

# Resend, free tier 3,000 emails/month, 100/day, no card: https://resend.com/api-keys
RESEND_API_KEY=

# Sender on your verified domain, and the public URL of the signup page
FROM_EMAIL=dan@danstaub.com
APP_URL=https://alerts.danstaub.com

# Optional overrides (defaults: Roswell 34.0232, -84.3616, 25 miles (40 km), last 7 days)
# LAT=34.0232
# LNG=-84.3616
# DIST_KM=40
# BACK_DAYS=7
# PORT=8000
